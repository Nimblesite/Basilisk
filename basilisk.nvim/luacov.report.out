    --- Basilisk — a strict-by-default Python type checker for Neovim.
    ---
    --- Entry point: require('basilisk').setup({})
    --- Zero-config works out of the box.

  3 local config_mod = require("basilisk.config")
  3 local lsp = require("basilisk.lsp")
  3 local commands = require("basilisk.commands")
  3 local log = require("basilisk.log")

  3 local M = {}

    --- Resolved configuration (populated after setup).
    ---@type BasiliskConfig?
  3 M.config = nil

    --- Whether setup() has been called.
  3 local did_setup = false

    --- Register LSP command handlers for custom commands.
    local function register_lsp_commands()
**0   vim.lsp.commands["basilisk.organizeImports"] = function(cmd, ctx)
**0     local edit = cmd.edit or cmd.arguments and cmd.arguments[1]
**0     if edit then
**0       vim.lsp.util.apply_workspace_edit(edit, "utf-8")
        end
      end
    end

    --- Set up Basilisk with the given options.
    ---@param opts? table User configuration (merged with defaults).
  3 function M.setup(opts)
**0   if did_setup then
**0     return
      end
**0   did_setup = true

**0   M.config = config_mod.resolve(opts)

      -- Configure logging.
**0   log.set_level(M.config.log_level)
**0   log.info("setup started")

      -- Register custom LSP command handlers.
**0   register_lsp_commands()

      -- Start the LSP client.
**0   lsp.start(M.config)

      -- Register user commands.
**0   commands.register(M.config)

      -- Register DAP adapter if nvim-dap is available.
**0   local dap_ok, dap_mod = pcall(require, "basilisk.dap")
**0   if dap_ok then
**0     dap_mod.setup(M.config)
      end

      -- Set up tab tracking for openFilesOnly mode.
**0   local tab_tracking = require("basilisk.tab_tracking")
**0   tab_tracking.setup(M.config)

**0   log.info("setup complete")
    end

  3 return M

