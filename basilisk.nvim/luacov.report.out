     ---@param ... any Format arguments.
     local function log(level, fmt, ...)
  66   if level < min_level then
  16     return
       end
  50   local msg = string.format(fmt, ...)
  50   vim.notify("[basilisk] " .. msg, level)
  50   if log_file then
   1     log_file:write(string.format("%s [%s] %s\n", os.date("%Y-%m-%d %H:%M:%S"), level, msg))
   1     log_file:flush()
       end
     end

   1 function M.trace(fmt, ...)
   5   log(vim.log.levels.TRACE, fmt, ...)
     end

   1 function M.debug(fmt, ...)
  11   log(vim.log.levels.DEBUG, fmt, ...)
     end

   1 function M.info(fmt, ...)
  29   log(vim.log.levels.INFO, fmt, ...)
     end

   1 function M.warn(fmt, ...)
  15   log(vim.log.levels.WARN, fmt, ...)
     end

   1 function M.error(fmt, ...)
   6   log(vim.log.levels.ERROR, fmt, ...)
     end

   1 return M

