     --- Tab tracking for openFilesOnly analysis mode.
     ---
     --- In openFilesOnly mode, diagnostics should clear when files close.
     --- Neovim doesn't reliably fire didClose when a buffer is hidden, so
     --- we track buffer visibility and send didClose manually.

   1 local log = require("basilisk.log")

   1 local M = {}

     --- Set of URIs we know are visible in windows.
     ---@type table<string, boolean>
   1 local known_open_uris = {}

     --- Get the first active basilisk LSP client, or nil.
     ---@return vim.lsp.Client?
     local function get_client()
   4   local clients = vim.lsp.get_clients({ name = "basilisk" })
   4   return clients[1]
     end

     --- Collect all Python file URIs currently visible in windows.
     ---@return table<string, boolean>
     local function collect_visible_python_uris()
   5   local uris = {}
  11   for _, win in ipairs(vim.api.nvim_list_wins()) do
   6     local buf = vim.api.nvim_win_get_buf(win)
  18     if vim.bo[buf].filetype == "python" then
   1       local name = vim.api.nvim_buf_get_name(buf)
   1       if name ~= "" then
   3         uris[vim.uri_from_fname(name)] = true
           end
         end
       end
   5   return uris
     end

     --- Check for closed Python tabs and send didClose.
     ---@param config BasiliskConfig
     local function check_closed_tabs(config)
   4   if config.analysis_mode ~= "openFilesOnly" then
***0     return
       end

   4   local client = get_client()
   4   if not client then
***0     return
       end

   4   local current_uris = collect_visible_python_uris()

       -- Find URIs that were open but are no longer visible.
   5   for uri in pairs(known_open_uris) do
   1     if not current_uris[uri] then
   2       client:notify("textDocument/didClose", {
   1         textDocument = { uri = uri },
           })
   1       log.debug("sent didClose for hidden buffer: %s", uri)
         end
       end

   4   known_open_uris = current_uris
     end

     --- Set up tab tracking autocmds.
     ---@param config BasiliskConfig
   1 function M.setup(config)
   4   if config.analysis_mode ~= "openFilesOnly" then
   3     return
       end

   1   local group = vim.api.nvim_create_augroup("BasiliskTabTracking", { clear = true })

       -- Track when buffers become hidden or windows change.
   2   vim.api.nvim_create_autocmd({ "BufHidden", "WinClosed", "BufDelete" }, {
   1     group = group,
         pattern = "*.py",
         callback = function()
   8       vim.defer_fn(function()
   4         check_closed_tabs(config)
   8       end, 100)
         end,
       })

       -- Seed with currently visible buffers.
   2   known_open_uris = collect_visible_python_uris()

   1   log.debug("tab tracking enabled for openFilesOnly mode")
     end

   1 return M

