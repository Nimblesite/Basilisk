    --- Status line component for Basilisk.
    ---
    --- Compatible with lualine.nvim, heirline.nvim, or any status line
    --- that accepts a function returning a string.

  1 local M = {}

    ---@alias BasiliskState "starting"|"ready"|"error"|"stopped"

    --- Current server state.
    ---@type BasiliskState
  1 local state = "stopped"

    --- Whether state was set manually (should not be overridden by update).
  1 local state_pinned = false

    --- Cached diagnostic counts.
  1 local error_count = 0
  1 local warn_count = 0

    --- State display configuration.
  1 local STATE_DISPLAY = {
  1   starting = { icon = "\u{27f3}", text = "Basilisk", color = "DiagnosticWarn" },
  1   ready = { icon = "\u{2713}", text = "Basilisk", color = "DiagnosticOk" },
  1   error = { icon = "\u{2717}", text = "Basilisk", color = "DiagnosticError" },
  1   stopped = { icon = "\u{2298}", text = "Basilisk", color = "Comment" },
    }

    --- Update the cached state from LSP client status.
  1 function M.update()
      -- Do not override manually-pinned states (e.g., "error" after max restarts).
  2   if state_pinned then
**0     return
      end

  2   local clients = vim.lsp.get_clients({ name = "basilisk" })
  2   if #clients == 0 then
**0     state = "stopped"
**0     error_count = 0
**0     warn_count = 0
**0     return
      end

  2   state = "ready"

      -- Count diagnostics across all buffers.
  2   local errors = 0
  2   local warns = 0
  5   for _, diag in ipairs(vim.diagnostic.get(nil, { namespace = nil })) do
  3     if diag.source == "basilisk" or (diag.code and tostring(diag.code):match("^BSK")) then
  3       if diag.severity == vim.diagnostic.severity.ERROR then
  2         errors = errors + 1
  1       elseif diag.severity == vim.diagnostic.severity.WARN then
  1         warns = warns + 1
          end
        end
      end
  2   error_count = errors
  2   warn_count = warns
    end

    --- Get the status line text.
    ---@return string
  1 function M.get()
  2   M.update()
  2   local display = STATE_DISPLAY[state]
  2   local text = display.icon .. " " .. display.text
  2   if state == "ready" and (error_count > 0 or warn_count > 0) then
  2     text = text .. string.format(" (%dE %dW)", error_count, warn_count)
      end
  2   return text
    end

    --- Get the highlight group for the current state.
    ---@return string
  1 function M.get_color()
**0   M.update()
**0   local display = STATE_DISPLAY[state]
**0   if state == "ready" and error_count > 0 then
**0     return "DiagnosticWarn"
      end
**0   return display.color
    end

    --- Lualine-compatible component table.
  1 M.lualine_component = {
      function()
**0     return M.get()
      end,
      color = function()
**0     return { fg = vim.api.nvim_get_hl(0, { name = M.get_color() }).fg }
      end,
  1 }

    --- Set the state directly (for use by lsp.lua on error/restart).
    --- Pinned states ("starting", "error") are not overridden by update().
    --- "ready" and "stopped" unpin, allowing normal update flow.
    ---@param new_state BasiliskState
