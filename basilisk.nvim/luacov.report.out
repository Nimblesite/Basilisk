     --- DAP integration for Basilisk.
     ---
     --- Registers an nvim-dap adapter that communicates with the basilisk LSP
     --- to spawn debugpy sessions. Implements DapTcpProxy using vim.uv (libuv).

   1 local log = require("basilisk.log")

   1 local M = {}

     --- Content-Length header pattern for DAP message framing.
   1 local CONTENT_LENGTH_PATTERN = "^Content%-Length: (%d+)\r\n\r\n"

     --- Parse a DAP message from a buffer.
     ---@param data string Raw data buffer.
     ---@return table? message Parsed JSON message, or nil if incomplete.
     ---@return string remaining Remaining unparsed data.
     local function parse_dap_message(data)
***0   local len_str = data:match(CONTENT_LENGTH_PATTERN)
***0   if not len_str then
***0     return nil, data
       end

***0   local header_end = data:find("\r\n\r\n", 1, true)
***0   if not header_end then
***0     return nil, data
       end

***0   local content_start = header_end + 4
***0   local content_length = tonumber(len_str)
***0   if #data < content_start + content_length - 1 then
***0     return nil, data
       end

***0   local body = data:sub(content_start, content_start + content_length - 1)
***0   local remaining = data:sub(content_start + content_length)
***0   local ok, msg = pcall(vim.json.decode, body)
***0   if not ok then
***0     log.error("DAP message parse error: %s", tostring(msg))
***0     return nil, remaining
       end
***0   return msg, remaining
     end

     --- Frame a DAP message with Content-Length header.
     ---@param msg table JSON-serializable message.
     ---@return string framed Framed message with header.
     local function frame_dap_message(msg)
***0   local body = vim.json.encode(msg)
***0   return string.format("Content-Length: %d\r\n\r\n%s", #body, body)
     end

     --- Check whether a line is structural (try:, with:, if:, etc.)
     ---@param msg table DAP message.
     ---@return boolean
