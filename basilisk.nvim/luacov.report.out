     --- Binary resolution for the basilisk executable.
     ---
     --- Follows the cascade defined in LSP-SPEC.md:
     --- 1. User-configured path (editor setting)
     --- 2. BASILISK_PATH environment variable
     --- 3. ~/.cargo/bin/basilisk
     --- 4. /usr/local/bin/basilisk
     --- 5. /opt/homebrew/bin/basilisk
     --- 6. Fall back to OS PATH search

   1 local M = {}

     --- Check whether a file exists and is executable.
     ---@param path string
     ---@return boolean
     local function is_executable(path)
  62   return vim.fn.executable(path) == 1
     end

     --- Resolve the basilisk binary path using the LSP-SPEC cascade.
     ---@param configured_path? string User-configured path from setup().
     ---@return string? path Absolute path to the binary, or nil if not found.
   1 function M.resolve(configured_path)
       -- 1. User-configured path.
  23   if configured_path and configured_path ~= "" then
   8     if is_executable(configured_path) then
   2       return configured_path
         end
   4     vim.notify(
   2       "[basilisk] configured binary_path not found: " .. configured_path,
   2       vim.log.levels.WARN
   2     )
       end

       -- 2. BASILISK_PATH environment variable.
  21   local env_path = vim.env.BASILISK_PATH
  23   if env_path and env_path ~= "" and is_executable(env_path) then
   1     return env_path
       end

       -- 3-5. Well-known locations.
  20   local candidates = {
  40     vim.fn.expand("~/.cargo/bin/basilisk"),
         "/usr/local/bin/basilisk",
         "/opt/homebrew/bin/basilisk",
       }
  20   for _, candidate in ipairs(candidates) do
  40     if is_executable(candidate) then
  20       return candidate
         end
       end

       -- 6. OS PATH search.
***0   local on_path = vim.fn.exepath("basilisk")
***0   if on_path ~= "" then
***0     return on_path
       end

***0   return nil
     end

     --- Get the version string from the binary.
     ---@param binary_path string
     ---@return string? version
   1 function M.version(binary_path)
  10   if not is_executable(binary_path) then
   1     return nil
       end
   4   local ok, result = pcall(vim.fn.system, { binary_path, "--version" })
   8   if not ok or vim.v.shell_error ~= 0 then
   1     return nil
       end
   3   return vim.trim(result)
     end

   1 return M

