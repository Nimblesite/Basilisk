    --- Logger for basilisk.nvim.
    ---
    --- Wraps vim.notify with configurable log levels and optional file logging.

  3 local M = {}

    --- Log level names to vim.log.levels mapping.
    ---@type table<string, integer>
  3 local LEVELS = {
