 11   },
 11   uv = {
        enabled = true,
        executable_path = nil,
        auto_sync = false,
        stub_suggestions = true,
        dependency_diagnostics = true,
 11   },
 11   keymaps = {
        enabled = true,
        prefix = "<leader>b",
 11   },
 11   statusline = {
        enabled = true,
 11   },
      log_level = "info",
 11 }

    --- Validate the resolved config.
    ---@param config BasiliskConfig
    ---@return string[] errors List of validation error messages.
 11 function M.validate(config)
 14   local errors = {}
 14   local valid_modes = { openFilesOnly = true, wholeModule = true, crossModule = true }
 14   if not valid_modes[config.analysis_mode] then
**0     errors[#errors + 1] = "invalid analysis_mode: " .. tostring(config.analysis_mode)
      end
 14   local valid_frameworks = { auto = true, pytest = true, unittest = true }
 14   if not valid_frameworks[config.test_explorer.framework] then
**0     errors[#errors + 1] = "invalid test_explorer.framework: " .. tostring(config.test_explorer.framework)
      end
 14   local valid_positions = { left = true, right = true, bottom = true }
 14   if not valid_positions[config.test_explorer.position] then
**0     errors[#errors + 1] = "invalid test_explorer.position: " .. tostring(config.test_explorer.position)
      end
 14   local valid_levels = { trace = true, debug = true, info = true, warn = true, error = true }
 14   if not valid_levels[config.log_level] then
**0     errors[#errors + 1] = "invalid log_level: " .. tostring(config.log_level)
      end
 14   return errors
    end

    --- Merge user options with defaults and validate.
    ---@param opts? table
    ---@return BasiliskConfig
 11 function M.resolve(opts)
 14   local config = vim.tbl_deep_extend("force", {}, M.defaults, opts or {})
 14   local errors = M.validate(config)
 14   for _, err in ipairs(errors) do
**0     vim.notify("[basilisk] config error: " .. err, vim.log.levels.ERROR)
      end
 14   return config
    end

 11 return M

