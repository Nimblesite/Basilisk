**0   if force then
**0     restart_count = 0
      end

**0   if restart_count >= MAX_RESTARTS then
**0     vim.notify(
**0       "[basilisk] max restarts reached (" .. MAX_RESTARTS .. "). Use :BasiliskRestart to force.",
**0       vim.log.levels.ERROR
        )
**0     return
      end

**0   local delay = BACKOFF_MS[restart_count + 1] or BACKOFF_MS[#BACKOFF_MS]
**0   restart_count = restart_count + 1

**0   vim.defer_fn(function()
