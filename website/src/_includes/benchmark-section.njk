{#
  Shared benchmark section — the SINGLE source of truth for rendering the
  homepage benchmark table in EVERY locale. Both src/index.njk and
  src/zh/index.njk call this macro; the data-driven rendering logic (reading
  `benchmarks` from _data/benchmarks.js, the tool/row loops, the fastest mark,
  the machine caption) is written exactly once here. Pages supply only
  translated prose via `t`.

  Args:
    b  — the global `benchmarks` data object (from _data/benchmarks.js)
    t  — locale strings. Prose fields are rendered with `| safe` so they may
         contain inline HTML (<br>, <code>, <em>, &mdash;). Caption fragments
         wrap the dynamic machine values so word order stays natural per-locale.
         Optional `t.names` is a { fixture: translatedName } map; any fixture
         not present falls back to the English `row.name`.
#}
{# Bare table + versions + methodology caption, no outer <section>/heading, so it
   embeds inside docs prose (`.docs-content`) as well as any section wrapper. #}
{% macro table(b, t) %}
    {% if b.hasData %}
    <div class="table-wrapper">
      <table class="benchmark-table">
        <thead>
          <tr>
            <th>{{ t.ruleHeader }}</th>
            {% for tool in b.tools %}<th{% if tool == 'basilisk' %} class="col-basilisk"{% endif %}>{{ tool }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in b.rows %}
          <tr>
            <td>{{ row.code }} {{ t.names[row.fixture] if t.names and t.names[row.fixture] else row.name }}</td>
            {% for cell in row.cells %}<td{% if cell.tool == 'basilisk' %} class="col-basilisk"{% endif %}>{{ cell.text }}{% if cell.fastest %} ✓{% endif %}</td>{% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if b.meta.toolVersions.length %}
    <dl class="bench-versions" aria-label="{{ t.versionsLabel }}">
      <dt>{{ t.versionsLabel }}</dt>
      {% for v in b.meta.toolVersions %}<dd><code{% if v.tool == 'basilisk' %} class="col-basilisk"{% endif %}>{{ v.tool }} {{ v.version }}</code></dd>{% endfor %}
    </dl>
    {% endif %}
    <p class="bench-meta">{{ t.metaPre | safe }}{{ b.meta.runsCount }}{{ t.metaMid | safe }}<strong>{{ b.meta.cpu }}</strong>{{ t.metaCpuOpen | safe }}{{ b.meta.os }}{{ t.metaOsSep | safe }}{{ b.meta.cores }}{{ t.metaCoresClose | safe }}{{ b.meta.generated }}{{ t.metaDateClose | safe }}<code>benchmarks/status/{{ b.primary }}.csv</code>{{ t.metaEnd | safe }}</p>
    {% endif %}
{% endmacro %}

{# Warm re-check table: every tool at its FASTEST achievable repeat-check.
   Tools with a real cross-run cache (basilisk `--cache`, mypy incremental
   `.mypy_cache`) show their warm number, tagged `t.warmTag`; tools with no
   cross-run cache show their cold time — their true best case — tagged
   `t.noCacheTag`. `b.warm` comes from computeWarm in _data/benchmarks.js, the
   same parsed CSV as the cold table, so the two can never disagree. #}
{% macro warmTable(b, t) %}
    {% if b.warm.hasData %}
    <div class="table-wrapper">
      <table class="benchmark-table">
        <thead>
          <tr>
            <th>{{ t.ruleHeader }}</th>
            {% for col in b.warm.columns %}<th{% if col.tool == 'basilisk' %} class="col-basilisk"{% endif %}>{{ col.tool }} <span class="bench-cache-tag">{{ t.warmTag if col.cached else t.noCacheTag }}</span></th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in b.warm.rows %}
          <tr>
            <td>{{ row.code }} {{ t.names[row.fixture] if t.names and t.names[row.fixture] else row.name }}</td>
            {% for cell in row.cells %}<td{% if cell.tool == 'basilisk' %} class="col-basilisk"{% endif %}>{{ cell.text }}{% if cell.fastest %} ✓{% endif %}</td>{% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
{% endmacro %}
