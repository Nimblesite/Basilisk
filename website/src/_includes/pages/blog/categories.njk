---
layout: layouts/base.njk
title: Categories
permalink: /blog/categories/
isBlogPost: false
---
{% from "components/blog.njk" import masthead, navigation with context %}
{% set categoryCollection = collections.categoryList %}
{% set categoryGroups = collections.postsByCategory %}
{% if lang and lang != defaultLanguage %}
  {% set categoryCollection = collections[lang + "categoryList"] | default(collections.categoryList) %}
  {% set categoryGroups = collections[lang + "postsByCategory"] | default(collections.postsByCategory) %}
{% endif %}
{% set langPrefix = "/" + lang if lang and lang != defaultLanguage else "" %}

<div class="blog-container">
  {{ masthead("blog.categoriesTitle" | t(lang) | default("Categories"), "blog.categoriesDescription" | t(lang) | default("Browse blog posts by category."), lang) }}
  {{ navigation(lang, defaultLanguage, "categories") }}

  {% if categoryCollection | length %}
  <div class="category-grid">
    {% for category in categoryCollection %}
    {% set categoryCount = categoryGroups[category] | length | default(0) %}
    {% set categoryLabel = category | blogCategoryLabel(lang) %}
    <a href="{{ langPrefix }}/blog/categories/{{ category | slugify }}/" class="category-card">
      <span>0{{ loop.index }}</span>
      <h2>{{ categoryLabel }}</h2>
      <p>{{ categoryCount }} {% if categoryCount == 1 %}{{ "blog.article" | t(lang) | default("article") }}{% else %}{{ "blog.articles" | t(lang) | default("articles") }}{% endif %}</p>
      <strong aria-hidden="true">→</strong>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="blog-empty"><p>{{ "blog.noCategories" | t(lang) | default("No categories yet. Check back soon!") }}</p></div>
  {% endif %}
</div>
