---
layout: layouts/base.njk
title: Blog
permalink: /blog/
---
{% from "components/blog.njk" import masthead, navigation, postCard %}
{% set postCollection = collections.posts %}
{% if lang and lang != defaultLanguage %}
  {% set postCollection = collections[lang + "posts"] | default(collections.posts) %}
{% endif %}

<div class="blog-container">
  {{ masthead("blog.headline" | t(lang) | default("Ideas for safer Python."), "blog.subtitle" | t(lang) | default(site.description), lang) }}
  {{ navigation(lang, defaultLanguage, "all") }}

  {% if postCollection | length %}
  <section aria-labelledby="latest-writing">
    <div class="blog-section-head">
      <div>
        <p class="blog-kicker">{{ "blog.latestEyebrow" | t(lang) | default("From the project") }}</p>
        <h2 id="latest-writing">{{ "blog.latest" | t(lang) | default("Latest writing") }}</h2>
      </div>
      <p>{{ postCollection | length }} {{ "blog.articles" | t(lang) | default("articles") }}</p>
    </div>
    <div class="post-list">
      {% for post in postCollection %}
        {{ postCard(post, lang, defaultLanguage, loop.first) }}
      {% endfor %}
    </div>
  </section>
  {% else %}
  <div class="blog-empty"><p>{{ "blog.empty" | t(lang) | default("No blog posts yet. Check back soon!") }}</p></div>
  {% endif %}
</div>
