---json
{
  "permalink": "feed.xml",
  "eleventyExcludeFromCollections": true
}
---
{#- Implements [WITHDRAWAL-COPY-SHORT]. The blog is gone, but people are still
    subscribed to this feed, so it carries the statement as its one entry rather
    than going silent. The timestamp is fixed: deriving it from build time would
    republish the entry on every deploy. -#}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ withdrawal.title }}</title>
  <subtitle>{{ withdrawal.line }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>2026-08-10T00:00:00Z</updated>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.organization.name }}</name></author>
  <entry>
    <title>{{ withdrawal.title }}</title>
    <link href="{{ site.url }}/"/>
    <id>{{ site.url }}/#withdrawal</id>
    <updated>2026-08-10T00:00:00Z</updated>
    <summary>{{ withdrawal.line }}</summary>
    <content type="html" xml:base="{{ site.url }}/"><![CDATA[{% for paragraph in withdrawal.short %}<p>{{ paragraph | safe }}</p>{% endfor %}]]></content>
  </entry>
</feed>
