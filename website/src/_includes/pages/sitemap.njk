---json
{
  "permalink": "sitemap.xml",
  "eleventyExcludeFromCollections": true
}
---
{#- Implements [WITHDRAWAL-SURFACES]. The site is one statement plus a notice at
    every retired URL. Only the statement is submitted for indexing: the notice
    pages are 297 byte-identical copies, and listing them would ask search
    engines to index the same paragraph 297 times. They stay reachable — and
    carry `noindex` — so an old link still explains itself. -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <priority>1.0</priority>
    <changefreq>monthly</changefreq>
  </url>
</urlset>
