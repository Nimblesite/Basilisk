<!-- ═══════════════════════════════════════════════════════
     FEATURES
═══════════════════════════════════════════════════════ -->
<section class="features section">
  <div class="container">
    <h2 class="section__headline">Built different, by design</h2>
    <p class="section__subhead">
      Every other Python type checker asks you to opt in to strictness.
      Basilisk starts there.
    </p>

    <div class="feature-grid">

      <div class="feature-card">
        <div class="feature-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="feature-card__title">Strict by Default</h3>
        <p class="feature-card__body">
          No <code>--strict</code> flag. No gradual mode. No opt-in.
          Basilisk treats every untyped function as a type error &mdash;
          because that's what it is. The safe path is the only path.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3 class="feature-card__title">Sub-10ms Incremental Checks</h3>
        <p class="feature-card__body">
          Powered by Salsa &mdash; the same incremental computation framework
          behind rust-analyzer. Only recomputes what changed.
          Keystroke-responsive in any editor.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <h3 class="feature-card__title">Single Binary, Zero Runtime</h3>
        <p class="feature-card__body">
          Ships as a standalone Rust binary. No Node.js. No Python interpreter.
          No <code>npm install</code>. Drop it in your PATH and it works
          everywhere Python code lives.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h3 class="feature-card__title">Mojo-Inspired Ownership</h3>
        <p class="feature-card__body">
          Add <code>Borrowed</code>, <code>InOut</code>, and <code>Owned</code>
          annotations to express ownership semantics. Catch mutation of borrowed
          values and use-after-move in standard Python, today.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        </div>
        <h3 class="feature-card__title">Complete PEP Conformance</h3>
        <p class="feature-card__body">
          Targets 100% conformance with the Python typing specification.
          Not ~95%. Not ~58%. Every PEP from 484 to 742 &mdash;
          Protocols, ParamSpec, TypeVarTuple &mdash; enforced correctly.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
        </div>
        <h3 class="feature-card__title">Secure WASM Plugins</h3>
        <p class="feature-card__body">
          Extend Basilisk with WebAssembly plugins for Django, Pydantic,
          and SQLAlchemy type intelligence. Sandboxed by design.
          Portable across every platform.
        </p>
      </div>

    </div>
  </div>
</section>

