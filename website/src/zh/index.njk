          <span class="code-window__dot code-window__dot--min"></span>
          <span class="code-window__dot code-window__dot--expand"></span>
          <span class="code-window__filename">终端</span>
        </div>
        <div class="code-window__body">
<pre><span class="tok-cmt"># macOS / Linux (Homebrew)</span>
<span class="tok-fn">brew</span> install Nimblesite/tap/basilisk

<span class="tok-cmt"># Windows (Scoop)</span>
<span class="tok-fn">scoop</span> install basilisk

<span class="tok-cmt"># 然后直接运行</span>
<span class="tok-fn">basilisk</span> check src/</pre>
