{
  "name": "basilisk",
  "displayName": "Basilisk",
  "description": "Strict-by-default Python type checker. Every parameter typed. Every return declared.",
  "version": "0.1.0",
  "publisher": "basilisk-lang",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/basilisk-lang/basilisk"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "python",
    "type checker",
    "static analysis",
    "basilisk"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "basilisk.restartServer",
        "title": "Basilisk: Restart Language Server",
        "category": "Basilisk"
      },
      {
        "command": "basilisk.showOutput",
        "title": "Basilisk: Show Output",
        "category": "Basilisk"
      },
      {
        "command": "basilisk.organizeImports",
        "title": "Basilisk: Organize Imports",
        "category": "Basilisk"
      }
    ],
    "configuration": {
      "title": "Basilisk",
      "properties": {
        "basilisk.executablePath": {
          "type": "string",
          "default": "basilisk",
          "description": "Path to the basilisk binary. Defaults to 'basilisk' (must be on PATH)."
        },
        "basilisk.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Basilisk type checker."
        },
        "basilisk.useLsp": {
          "type": "boolean",
          "default": true,
          "description": "Use the LSP server for real-time diagnostics. Disable to fall back to subprocess mode."
        },
        "basilisk.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP communication for debugging."
        },
        "basilisk.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter name hints at call sites."
        },
        "basilisk.inlayHints.variableTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred type hints for unannotated variables."
        },
        "basilisk.ruff.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Ruff integration for formatting and import organization."
        },
        "basilisk.ruff.executablePath": {
          "type": "string",
          "default": "ruff",
          "description": "Path to the ruff binary."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^10.0.2",
    "typescript": "^5.3.0"
  }
}
