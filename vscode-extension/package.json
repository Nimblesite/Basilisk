{
  "name": "basilisk",
  "displayName": "Basilisk",
  "description": "The open-source Pylance replacement. Strict-by-default Python type checking, completions, go-to-definition, hover, diagnostics — everything Pylance does, fully open source. Built in Rust.",
  "version": "0.1.0",
  "publisher": "basilisk-lang",
  "license": "MIT",
  "icon": "images/basilisk-logo.png",
  "galleryBanner": {
    "color": "#0a0c12",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MelbourneDeveloper/Basilisk"
  },
  "homepage": "https://www.basilisk-python.dev",
  "bugs": {
    "url": "https://github.com/MelbourneDeveloper/Basilisk/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "python",
    "language server",
    "pylance",
    "pyright",
    "type checker",
    "intellisense",
    "autocomplete",
    "go to definition",
    "rust",
    "basilisk",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "basilisk.restartServer",
        "title": "Basilisk: Restart Language Server",
        "category": "Basilisk"
      },
      {
        "command": "basilisk.showOutput",
        "title": "Basilisk: Show Output",
        "category": "Basilisk"
      },
      {
        "command": "basilisk.organizeImports",
        "title": "Basilisk: Organize Imports",
        "category": "Basilisk"
      }
    ],
    "configuration": {
      "title": "Basilisk",
      "properties": {
        "basilisk.executablePath": {
          "type": "string",
          "default": "basilisk",
          "description": "Path to the basilisk binary. Defaults to 'basilisk' (must be on PATH)."
        },
        "basilisk.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Basilisk type checker."
        },
        "basilisk.useLsp": {
          "type": "boolean",
          "default": true,
          "description": "Use the LSP server for real-time diagnostics. Disable to fall back to subprocess mode."
        },
        "basilisk.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication for debugging."
        },
        "basilisk.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter name hints at call sites."
        },
        "basilisk.inlayHints.variableTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred type hints for unannotated variables."
        },
        "basilisk.ruff.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Ruff integration for formatting and import organization."
        },
        "basilisk.ruff.executablePath": {
          "type": "string",
          "default": "ruff",
          "description": "Path to the ruff binary."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vscode-test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "tar": "^7.5.11",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/tar": "^6.1.13",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^10.0.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.3.0"
  }
}
