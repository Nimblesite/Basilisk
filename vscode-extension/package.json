{
  "name": "basilisk",
  "displayName": "Basilisk",
  "description": "Basilisk's type checker produced incorrect results. Basilisk is unlisted and is being rebuilt from the ground up as a new product.",
  "version": "0.0.0-PLACEHOLDER",
  "publisher": "Nimblesite",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "images/basilisk-logo.png",
  "galleryBanner": {
    "color": "#0a0c12",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nimblesite/Basilisk"
  },
  "homepage": "https://www.basilisk-python.dev",
  "bugs": {
    "url": "https://github.com/Nimblesite/Basilisk/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "basilisk"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "basilisk.showStatement",
        "title": "Basilisk: Why is Basilisk unlisted?",
        "category": "Basilisk"
      }
    ]
  },
  "scripts": {
    "licenses:update": "node scripts/update-dependency-licenses.mjs",
    "licenses:check": "node scripts/update-dependency-licenses.mjs --check",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vscode-test --bail",
    "test:shipwright": "node scripts/verify-shipwright.mjs manifest && npm run licenses:check",
    "vscode:prepublish": "npm run compile",
    "package": "cd .. && make _release_vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.6"
  }
}
